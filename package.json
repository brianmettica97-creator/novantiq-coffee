{
  "name": "novantiq-coffee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
