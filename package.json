    "seed:generate": "tsx scripts/generate-seed-sql.ts",
    "sync:shared": "node scripts/sync-shared.mjs",
    "media:demo": "node scripts/media/build-demo-media.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "idb-keyval": "^6.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
