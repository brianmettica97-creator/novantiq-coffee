# ---------------------------------------------------------------------------
# NOVANTIQ COFFEE · variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# Todas las variables VITE_* quedan VISIBLES en el navegador: no pongas aquí
# ninguna clave privada. La service role key de Supabase NUNCA va al frontend.
# ---------------------------------------------------------------------------

# URL del proyecto Supabase (Project Settings → API → Project URL).
# Si se deja vacía, la app funciona en MODO LOCAL de demostración
# (datos guardados solo en el navegador).
VITE_SUPABASE_URL=

# Clave pública "anon" / "publishable" de Supabase (Project Settings → API).
# Es pública por diseño: la seguridad la dan las políticas RLS.
VITE_SUPABASE_ANON_KEY=

# Dominio público de las cartas, usado en los códigos QR.
# Ejemplo: https://carta.novantiq.com  (sin barra final)
# Vacío: se usa el origen actual (o la IP de la red local en desarrollo).
VITE_PUBLIC_BASE_URL=

# Bucket de Supabase Storage para fotos y videos.
VITE_MEDIA_BUCKET=menu-media
